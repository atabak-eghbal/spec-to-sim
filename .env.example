# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs — confirm with `uv run python scripts/list_models.py`, then fill in
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_VL=nvidia/Nemotron-3.5-Super-VL

# --- Tavily ---
TAVILY_API_KEY=

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spec-to-sim

# --- Rendering ---
MUJOCO_GL=egl          # use osmesa on CPU-only machines

# --- Budget guardrails ---
MAX_ITERATIONS=4
DEV_SPEND_LIMIT_USD=20
